# Build directories
build/
**/build/

# ESP-IDF sdkconfig (contains credentials from menuconfig)
sdkconfig
sdkconfig.old
sdkconfig.credentials

# Managed components (downloaded by idf.py)
**/managed_components/

# Backups
backups/
*_backup_*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test/simulation code (not for production)
test/
examples/esp_modem_test/

# Internal development docs (contain test data, SIM details, peer names)
docs/PPP_ANALYSIS.md

# Logs
*.log

# OS
.DS_Store
Thumbs.db

#eim
eim_config.toml
examples/basic_connect/eim_config.toml
# 本機設定(WiFi 帳密、Tailnet 名稱),範本見 local_config.example.h
examples/*/main/local_config.h

# Serial 除錯記錄(含 tailnet 裝置名稱與對外 IP)
log*.txt
