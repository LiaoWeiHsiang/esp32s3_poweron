# MicroLink Credentials — DO NOT commit this file!
#
# 1. Copy this file to sdkconfig.credentials:
#      cp sdkconfig.credentials.example sdkconfig.credentials
# 2. Edit sdkconfig.credentials with your real values
# 3. Run: idf.py build
#
# Or set interactively: idf.py menuconfig → MicroLink V2 → Credentials

# CONFIG_ML_WIFI_SSID="your-wifi-ssid"
# CONFIG_ML_WIFI_PASSWORD="your-wifi-password"
#
# Additional networks: the firmware has 5 built-in default networks (tried
# first, hardcoded in main.c) plus a user-editable list managed via the
# config web UI (Settings -> WiFi Networks), which is tried after the
# defaults and persists in NVS.
#
# CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Built-in WiFi defaults are compiled into basic_connect and tried first.
# These Kconfig values are only a fallback for other examples.
CONFIG_ML_WIFI_SSID="EnglishTsai"
CONFIG_ML_WIFI_PASSWORD="22222222"
# Set this to your current Tailscale auth key in the local, git-ignored file.
# CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Optional: API key used only by the basic_connect dashboard device query.
# Keep this in the local, git-ignored sdkconfig.credentials file.
# CONFIG_ML_TAILSCALE_API_KEY="tskey-api-XXXXX"
